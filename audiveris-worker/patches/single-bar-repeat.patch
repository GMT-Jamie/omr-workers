+    //----------------//
+    // dotCountOnSide //
+    //----------------//
+    /**
+     * Count the repeat dots that lie on the provided side of this bar.
+     * <p>
+     * Used to decide whether a <b>single</b> barline carries a repeat sign: a real repeat
+     * always prints a pair of dots, so a lone dot is not enough evidence.
+     *
+     * @param right true for the right side, false for the left side
+     * @return the number of repeat dots found on that side
+     */
+    private int dotCountOnSide (boolean right)
+    {
+        final Point center = getCenter();
+        int count = 0;
+
+        for (Inter bar : getMembers()) {
+            for (Relation rel : sig.getRelations(bar, RepeatDotBarRelation.class)) {
+                final Inter dot = sig.getOppositeInter(bar, rel);
+                final boolean onRight = dot.getCenter().x > center.x;
+
+                if (onRight == right) {
+                    count++;
+                }
+            }
+        }
+
+        return count;
+    }
